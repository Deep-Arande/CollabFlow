# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (Supabase)
DATABASE_URL="postgresql://postgres:[password]@db.[ref].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# Auth
JWT_SECRET=your_super_secret_jwt_key_here

# Supabase Storage
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# AI (Google Gemini) — get a free key at https://aistudio.google.com ("Get API key")
# Required for the Catch Me Up and Project Assistant features. Without it, those
# endpoints return 503 and the rest of the app is unaffected.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional overrides (defaults shown). Only set if your key needs a different model.
# GEMINI_CHAT_MODEL=gemini-3.6-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
