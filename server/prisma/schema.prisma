generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum FileType {
  PDF
  IMAGE
  DOCX
}

enum ProjectRole {
  LEAD
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum AttachmentScope {
  TASK
  PROJECT
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects        ProjectMember[] @relation("MemberUser")
  sentInvites     ProjectMember[] @relation("MemberInviter")
  assignedTasks   Task[]          @relation("AssignedTasks")
  createdTasks    Task[]          @relation("CreatedTasks")
  comments        Comment[]
  attachments     Attachment[]
  activityLogs    ActivityLog[]
  mentions        CommentMention[]
  createdProjects Project[]
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String        @default("")
  dueDate     DateTime
  status      ProjectStatus @default(ACTIVE)
  createdBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Cached "Catch Me Up" summary (regenerated when stale > 30 min or ?force=true).
  catchMeUpSummary String?   @db.Text
  catchMeUpAt      DateTime?

  creator      User          @relation(fields: [createdBy], references: [id])
  members      ProjectMember[]
  tasks        Task[]
  labels       Label[]
  activityLogs ActivityLog[]
  attachments  Attachment[]
}

model ProjectMember {
  id          String       @id @default(uuid())
  projectId   String
  userId      String
  role        ProjectRole  @default(MEMBER)
  status      InviteStatus @default(PENDING)
  invitedBy   String
  addedAt     DateTime     @default(now())
  respondedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  inviter User    @relation("MemberInviter", fields: [invitedBy], references: [id])

  @@unique([projectId, userId])
}

model Task {
  id          String       @id @default(uuid())
  projectId   String
  title       String
  description String       @default("")
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  dueDate     DateTime?
  assignedTo  String?
  createdBy   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?        @relation("AssignedTasks", fields: [assignedTo], references: [id])
  creator     User         @relation("CreatedTasks", fields: [createdBy], references: [id])
  comments    Comment[]
  attachments Attachment[]
  labels      TaskLabel[]
}

model Label {
  id        String @id @default(uuid())
  projectId String
  name      String
  color     String

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   TaskLabel[]
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task     Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author   User             @relation(fields: [authorId], references: [id])
  mentions CommentMention[]
}

model CommentMention {
  id              String @id @default(uuid())
  commentId       String
  mentionedUserId String

  comment       Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser User    @relation(fields: [mentionedUserId], references: [id])
}

model Attachment {
  id            String          @id @default(uuid())
  taskId        String?
  projectId     String
  uploadedBy    String
  filePath      String
  fileType      FileType
  fileName      String
  extractedText String?         @db.Text
  scope         AttachmentScope
  createdAt     DateTime        @default(now())

  task     Task?           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User            @relation(fields: [uploadedBy], references: [id])
  chunks   DocumentChunk[]
}

// RAG chunk store. The `embedding` column is pgvector's `vector(768)` type, which
// Prisma cannot represent — it is declared Unsupported here and all reads/writes to
// it go through raw SQL in services/vectorStore.ts. Never use prisma.documentChunk
// .create()/.findMany() for the embedding; the ivfflat index is added by hand in the
// migration SQL.
model DocumentChunk {
  id           String                     @id @default(uuid())
  attachmentId String
  projectId    String
  chunkIndex   Int
  content      String                     @db.Text
  embedding    Unsupported("vector(768)")
  tokenCount   Int?
  createdAt    DateTime                   @default(now())

  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([attachmentId])
}

model ActivityLog {
  id         String   @id @default(uuid())
  projectId  String?
  userId     String
  action     String
  targetType String
  targetId   String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
}
